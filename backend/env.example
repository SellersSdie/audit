# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HubSpot - use a Private App token (not API key)
# Go to: Settings > Integrations > Private Apps > Create
# Scopes needed: crm.objects.contacts.write, crm.objects.contacts.read
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Port (Railway sets this automatically)
PORT=3000
